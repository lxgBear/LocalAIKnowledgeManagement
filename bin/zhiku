#!/usr/bin/env python3
"""智库库操作。只执行传入的操作，不决定下一步。"""

import argparse
import datetime as dt
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from lib import CLIError, USAGE, emit, fail, guard

ROOT = Path(os.environ.get("ZHIKU_ROOT", Path(__file__).resolve().parent.parent)).resolve()
FIELDS = ("触发词", "出处", "日期", "成立", "失效", "词", "释义", "例句", "钩子", "类型")


def rel(path):
    return path.resolve().relative_to(ROOT.resolve()).as_posix()


def run_git(*args):
    result = subprocess.run(
        ["git", *args], cwd=ROOT, text=True, capture_output=True, check=False
    )
    if result.returncode:
        raise CLIError(result.stderr.strip() or "git 失败")
    return result.stdout.strip()


def commit(path, message):
    run_git("add", "--", rel(path), "log.md")
    index = path.parent / "索引.md"
    if index.exists():
        run_git("add", "--", rel(index))
    run_git("commit", "-m", message)
    return run_git("rev-parse", "HEAD")


def read(path):
    guard(rel(path))
    return path.read_text(encoding="utf-8") if path.exists() else ""


def cards(text):
    starts = [match.start() for match in re.finditer(r"(?m)^## ", text)]
    found = []
    for index, start in enumerate(starts):
        end = starts[index + 1] if index + 1 < len(starts) else len(text)
        block = text[start:end]
        title = block.splitlines()[0][3:].strip()
        values = dict(re.findall(r"(?m)^- ([^：]+)：(.+)$", block))
        line = text[:start].count("\n") + 1
        found.append((line, title, values, block))
    return found


def append_log(action, title):
    today = dt.date.today().isoformat()
    path = ROOT / "log.md"
    with path.open("a", encoding="utf-8") as handle:
        handle.write(f"## [{today}] {action} | {title}\n")


def update_index(path, summary):
    index = path.parent / "索引.md"
    name = path.name
    lines = index.read_text(encoding="utf-8").splitlines() if index.exists() else ["# 索引"]
    row = f"- {name}：{summary}"
    for offset, line in enumerate(lines):
        if line.startswith(f"- {name}："):
            lines[offset] = row
            break
    else:
        lines.append(row)
    index.write_text("\n".join(lines).rstrip() + "\n", encoding="utf-8")


def card_text(title, body):
    values = dict(re.findall(r"(?m)^- ([^：]+)：(.+)$", body))
    if "日期" not in values or "出处" not in values:
        raise CLIError("卡片缺少日期或出处")
    try:
        dt.date.fromisoformat(values["日期"])
    except ValueError as error:
        raise CLIError("日期格式必须是 YYYY-MM-DD") from error
    lines = [f"## {title}"]
    lines.extend(f"- {field}：{values[field]}" for field in FIELDS if field in values)
    return "\n".join(lines) + "\n\n"


def command_add(args):
    body = sys.stdin.read()
    if args.update:
        file_name, line_text = args.update.rsplit(":", 1)
        path = ROOT / file_name
        line = int(line_text)
        text = read(path)
        found = [card for card in cards(text) if card[0] == line]
        if len(found) != 1:
            raise CLIError("行号没有对应卡片")
        _, title, values, old = found[0]
        revised = card_text(title, body)
        for field in ("触发词", "日期"):
            if values.get(field) and f"- {field}：" not in revised:
                revised = revised.rstrip() + f"\n- {field}：{values[field]}\n\n"
        today = dt.date.today().isoformat()
        revised = revised.rstrip() + f"\n- 改写于：{today}\n\n"
        path.write_text(text.replace(old, revised, 1), encoding="utf-8")
        append_log("改写", title)
        digest = commit(path, f"改写 {title}")
        emit({"commit": digest, "file": rel(path), "line": line, "action": "改写"})
        return
    if not args.type or not args.file:
        raise CLIError("追加需要 --type 和 --file", USAGE)
    path = ROOT / args.file
    if path.suffix != ".md" or not rel(path).startswith(("10-记忆/", "12-词典/", "20-手册/")):
        raise CLIError("归档位置必须在记忆、词典或手册分区", USAGE)
    text = card_text(args.type, body)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(text)
    line = read(path).count("\n") - text.count("\n") + 1
    update_index(path, args.type)
    append_log("追加", args.type)
    digest = commit(path, f"追加 {args.type}")
    emit({"commit": digest, "file": rel(path), "line": line, "action": "追加"})


def command_find(args):
    hits = []
    for path in ROOT.glob("*/*.md"):
        if "90-敏感" in path.parts:
            continue
        for line, title, values, _ in cards(read(path)):
            if args.trigger in values.get("触发词", ""):
                hits.append({"file": rel(path), "line": line, "text": title})
    emit({"hits": hits})


def overlaps(left, right):
    a = {item.strip() for item in left.split("、") if item.strip()}
    b = {item.strip() for item in right.split("、") if item.strip()}
    return bool(a and b and len(a & b) / len(a | b) > 1 / 3)


def item(kind, path, line, detail):
    return {"kind": kind, "file": rel(path), "line": line, "detail": detail}


def command_lint(_args):
    items = []
    indexed = {}
    for index in ROOT.glob("*/索引.md"):
        for line_number, line in enumerate(read(index).splitlines(), 1):
            match = re.match(r"- ([^：]+)：", line)
            if not match:
                continue
            target = index.parent / match.group(1)
            indexed[target] = (index, line_number)
            if not target.exists():
                items.append(item("失真", index, line_number, "索引指向不存在的文件"))
    seen = []
    for path in ROOT.glob("*/*.md"):
        if path.parent.name not in {"10-记忆", "12-词典", "20-手册"} or path.name == "索引.md":
            continue
        text = read(path)
        rows = text.splitlines()
        if path.name == "杂项.md" and len(rows) > 30:
            items.append(item("积压", path, 31, "杂项超过 30 行"))
        if len(rows) > 150:
            items.append(item("超长", path, 151, "文件超过 150 行"))
        if path not in indexed:
            items.append(item("孤儿", path, 1, "索引没有该文件"))
        for line, title, values, _ in cards(text):
            if "矛盾" in title:
                items.append(item("矛盾", path, line, title))
            recorded = dt.date.fromisoformat(values["日期"])
            if "可能过时" in title or (dt.date.today() - recorded).days > 365:
                items.append(item("过时", path, line, title))
            if path.parent.name == "12-词典" and "词" not in values:
                items.append(item("错位", path, line, "词典文件不是词条"))
            if path.parent.name == "10-记忆" and "主张" not in title and "词" in values:
                items.append(item("错位", path, line, "词条放在记忆分区"))
            if values.get("类型") == "想法" and (dt.date.today() - recorded).days > 90:
                items.append(item("孵化超期", path, line, title))
            for old_line, old_values, old_path in seen:
                if overlaps(values.get("触发词", ""), old_values.get("触发词", "")):
                    items.append(item("重复", path, line, f"与 {old_path}:{old_line} 重叠"))
            seen.append((line, values, rel(path)))
    emit({"items": items})


def command_migrate(args):
    source = Path(args.from_path).resolve()
    if not source.is_dir():
        raise CLIError("旧库路径不存在", USAGE)
    moved = []
    for path in source.rglob("*"):
        if not path.is_file() or path.name == ".DS_Store":
            continue
        relative = path.relative_to(source)
        sensitive = "keys" in relative.parts or "id_rsa" in path.name or path.suffix in {".pem", ".key"}
        section = "90-敏感" if sensitive else "20-手册"
        target = ROOT / section / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
        moved.append({"from": str(path), "to": rel(target)})

    append_log("迁移", source.name)
    if moved:
        run_git("add", "--", "20-手册", "90-敏感", "log.md")
        run_git("commit", "-m", f"迁移 {source.name}")
    emit({"moved": moved})


def command_archive(args):
    source = ROOT / args.src
    if not source.is_file():
        raise CLIError("收件箱文件不存在")
    month = dt.date.today().strftime("%Y-%m")
    target = ROOT / "99-archive" / "原料" / month / source.name
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        raise CLIError("归档目标已存在")
    shutil.move(source, target)
    append_log("归档", source.name)
    digest = commit(target, f"归档 {source.name}")
    emit({"archived": rel(target), "commit": digest})


def parse_args():
    parser = argparse.ArgumentParser(prog="zhiku")
    commands = parser.add_subparsers(dest="command", required=True)
    add = commands.add_parser("add")
    add.add_argument("--type")
    add.add_argument("--file")
    add.add_argument("--update")
    find = commands.add_parser("find")
    find.add_argument("--trigger", required=True)
    commands.add_parser("lint")
    archive = commands.add_parser("archive")
    archive.add_argument("--src", required=True)
    migrate = commands.add_parser("migrate")
    migrate.add_argument("--from", dest="from_path", required=True)
    return parser.parse_args()


def main():
    try:
        args = parse_args()
        {"add": command_add, "find": command_find, "lint": command_lint,
         "archive": command_archive, "migrate": command_migrate}[args.command](args)
    except CLIError as error:
        fail(str(error), error.code)
    except SystemExit:
        raise
    except Exception as error:
        fail(str(error))


if __name__ == "__main__":
    main()
